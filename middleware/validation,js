// middleware/validation.js
'use strict';

const { ValidationError } = require('./errors');

const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
const UUID_REGEX = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
const DATE_REGEX = /^\d{4}-\d{2}-\d{2}$/;
const OTP_REGEX = /^\d{6}$/;

function isNonEmptyString(value) {
  return typeof value === 'string' && value.trim().length > 0;
}

function validateEmail(value) {
  if (!isNonEmptyString(value)) return 'Must be a non-empty string';
  if (value.length > 254) return 'Must not exceed 254 characters';
  if (!EMAIL_REGEX.test(value)) return 'Must be a valid email address';
  return null;
}

function validateUUID(value) {
  if (!isNonEmptyString(value)) return 'Must be a non-empty string';
  if (!UUID_REGEX.test(value)) return 'Must be a valid UUID';
  return null;
}

function validateString(value, { minLength = 1, maxLength = 500 } = {}) {
  if (typeof value !== 'string') return 'Must be a string';
  if (value.trim().length < minLength) return `Must be at least ${minLength} characters`;
  if (value.length > maxLength) return `Must not exceed ${maxLength} characters`;
  return null;
}

function validateOptionalString(value, { maxLength = 500 } = {}) {
  if (value === undefined || value === null) return null;
  if (typeof value !== 'string') return 'Must be a string';
  if (value.length > maxLength) return `Must not exceed ${maxLength} characters`;
  return null;
}

function validateNumber(value, { min = -Infinity, max = Infinity } = {}) {
  if (typeof value !== 'number' || Number.isNaN(value)) return 'Must be a valid number';
  if (value < min) return `Must be at least ${min}`;
  if (value > max) return `Must not exceed ${max}`;
  return null;
}

function validateDateArray(value) {
  if (!Array.isArray(value)) return 'Must be an array';
  if (value.length === 0) return 'Must contain at least one date';
  if (value.length > 365) return 'Must not exceed 365 dates';
  for (let i = 0; i < value.length; i++) {
    if (typeof value[i] !== 'string' || !DATE_REGEX.test(value[i])) {
      return `Date at index ${i} must be in YYYY-MM-DD format`;
    }
    const parsed = new Date(value[i] + 'T00:00:00Z');
    if (Number.isNaN(parsed.getTime())) {
      return `Date at index ${i} is not a valid date`;
    }
  }
  return null;
}

function validateEnum(value, allowed) {
  if (!allowed.includes(value)) return `Must be one of: ${allowed.join(', ')}`;
  return null;
}

function validateObject(value) {
  if (value === null || typeof value !== 'object' || Array.isArray(value)) {
    return 'Must be a JSON object';
  }
  return null;
}

function sanitizeString(str) {
  if (typeof str !== 'string') return str;
  return str
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#x27;')
    .trim();
}

function sanitizeBody(req, res, next) {
  if (req.body && typeof req.body === 'object' && !Array.isArray(req.body)) {
    const sanitized = {};
    for (const [key, value] of Object.entries(req.body)) {
      if (typeof value === 'string') {
        sanitized[key] = sanitizeString(value);
      } else {
        sanitized[key] = value;
      }
    }
    req.body = sanitized;
  }
  next();
}

function validate(schema) {
  return (req, res, next) => {
    const errors = {};
    const body = req.body || {};

    for (const [field, rules] of Object.entries(schema)) {
      const value = body[field];
      const fieldErrors = [];

      if (rules.required && (value === undefined || value === null || value === '')) {
        fieldErrors.push(`${field} is required`);
      } else if (value !== undefined && value !== null && value !== '') {
        if (rules.type === 'email') {
          const err = validateEmail(value);
          if (err) fieldErrors.push(err);
        }
        if (rules.type === 'uuid') {
          const err = validateUUID(value);
          if (err) fieldErrors.push(err);
        }
        if (rules.type === 'string') {
          const err = validateString(value, {
            minLength: rules.minLength,
            maxLength: rules.maxLength,
          });
          if (err) fieldErrors.push(err);
        }
        if (rules.type === 'optionalString') {
          const err = validateOptionalString(value, { maxLength: rules.maxLength });
          if (err) fieldErrors.push(err);
        }
        if (rules.type === 'number') {
          const err = validateNumber(value, { min: rules.min, max: rules.max });
          if (err) fieldErrors.push(err);
        }
        if (rules.type === 'dateArray') {
          const err = validateDateArray(value);
          if (err) fieldErrors.push(err);
        }
        if (rules.type === 'enum') {
          const err = validateEnum(value, rules.allowed);
          if (err) fieldErrors.push(err);
        }
        if (rules.type === 'object') {
          const err = validateObject(value);
          if (err) fieldErrors.push(err);
        }
        if (rules.custom) {
          const err = rules.custom(value);
          if (err) fieldErrors.push(err);
        }
      }

      if (fieldErrors.length > 0) {
        errors[field] = fieldErrors;
      }
    }

    if (Object.keys(errors).length > 0) {
      return next(new ValidationError('Request validation failed', errors));
    }

    next();
  };
}

module.exports = {
  validate,
  sanitizeBody,
  validateEmail,
  validateUUID,
  validateString,
  validateNumber,
  validateDateArray,
  validateEnum,
};
